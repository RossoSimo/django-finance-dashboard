# Copy to .env and fill in. Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me
DEBUG=True
# Comma-separated hostnames the app may be served from
ALLOWED_HOSTS=localhost,127.0.0.1
# Allow new users to register themselves at /accounts/signup/
SIGNUP_ENABLED=True
# Local LLMs via Ollama (optional; see README)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_VISION_MODEL=qwen3-vl:8b-instruct
